# SynapseOS — environment configuration example (Phase 1)
# Copy this file to `.env` and adjust for your environment.
# NEVER commit real secrets. `.env` is git-ignored; only `.env.example` is tracked.

# --- Application ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# --- PostgreSQL (consumed by the docker-compose "db" service) ---
POSTGRES_USER=synapseos
POSTGRES_PASSWORD=change-me-in-your-local-env
POSTGRES_DB=synapseos

# Host-side pytest connects to the Docker-published PostgreSQL port.
TEST_POSTGRES_HOST=localhost
POSTGRES_PORT=55432
TEST_POSTGRES_PORT=55432

# --- Database URL used by the application (SQLAlchemy 2 + psycopg 3 driver) ---
# Host is "db" (the compose service name) when running via docker compose,
# or "localhost" when running the API directly on your machine.
DATABASE_URL=postgresql+psycopg://synapseos:change-me-in-your-local-env@db:5432/synapseos

# --- Local Ollama provider (Phase 4) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_RESPONSE_BYTES=10485760
